# Every variable here is required. config.service.ts validates them at module
# load, so a missing one throws `config error - missing env.<KEY>` on boot
# rather than failing later as a connection error.
NODE_ENV=development
PORT=3000
BASE_URL=http://127.0.0.1:3000
MONGO_DB_URL=mongodb://root:example@127.0.0.1:27017/urlshortener?authSource=admin
